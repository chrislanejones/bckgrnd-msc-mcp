          },
          "preset": {
            "description": "Saved local preset; explicitly supplied settings override it.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "music_path": {
            "type": "string",
            "minLength": 1
          },
          "output_path": {
            "type": "string"
          },
          "overwrite": {
            "default": false,
            "type": "boolean"
          },
          "video_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "video_path"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "bckgrnd_presets",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "get",
              "save",
              "delete"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "settings": {
            "type": "object",
            "properties": {
              "track": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "music_db": {
                "type": "number",
                "minimum": -40,
                "maximum": 0
              },
              "loudness_lufs": {
                "type": "number",
                "minimum": -30,
                "maximum": -9
              },
              "duck": {
                "type": "boolean"
              },
              "ducking": {
                "description": "Ducking strength; normal preserves the original compressor. duck:false disables it.",
                "type": "string",
                "enum": [
                  "subtle",
                  "normal",
                  "strong"
                ]
              },
              "cut": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "kick",
                    "clap",
                    "hats",
                    "bass",
                    "stab",
                    "lead",
                    "pad",
                    "arp"
                  ]
                }
              },
              "lead_in_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 30
              },
              "tail_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 30
              },
              "arrangement": {
                "description": "loop keeps the original arrangement; evolving gently changes stem levels every 16 bars.",
                "type": "string",
                "enum": [
                  "loop",
                  "evolving"
                ]
              },
              "final_lufs": {
                "description": "Optional loudness target for the finished mix, distinct from the voice target.",
                "type": "number",
                "minimum": -30,
                "maximum": -9
              },
              "true_peak_dbfs": {
                "description": "Peak ceiling when final_lufs is set; default -1.5 dBTP.",
                "type": "number",
                "minimum": -9,
                "maximum": -0.5
              }
            },
            "additionalProperties": false
          },
          "overwrite": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "action"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "bckgrnd_check_setup",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
