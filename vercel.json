{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:vercel",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60,
      "includeFiles": "vendor/**"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/",
      "destination": "/index.json"
    }
  ]
}
